{
  "description": "SessionStart hook that auto-installs the matching cp CLI when the plugin and CLI versions drift.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/sync-cli-version.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
